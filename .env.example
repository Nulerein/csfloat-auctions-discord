# Bot token: Discord Developer Portal -> your application -> Bot -> Reset Token.
# Treat it like a password: never share or publish it.
DISCORD_TOKEN=

# CSFloat API key: csfloat.com/profile -> Developer tab
CSFLOAT_API_KEY=

# Optional. Your server ID makes /auctions and /deals appear there immediately
# (otherwise, they may take a while to appear).
GUILD_ID=

# Optional. Channel ID for automatic auction alerts.
# If empty, the bot only responds to /auctions and /deals.
ALERT_CHANNEL_ID=
# How often to check CSFloat, in minutes (at least 1)
ALERT_INTERVAL_MIN=5
# Alert filters: maximum price in USD, ending within N hours, minimum discount in percent
ALERT_MAX_PRICE=30
ALERT_HOURS=6
ALERT_MIN_DISCOUNT=15
